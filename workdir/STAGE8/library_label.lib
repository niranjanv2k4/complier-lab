ALLOC:
MOV R5, "Alloc"
EQ R5, R1
JZ R5, FREE
MOV R1, [1024]
MOV R2, [R1]
MOV [1024], R2
MOV R3, BP
SUB R3, 2
MOV [R3], R1
POP BP
RET
FREE:
MOV R5, "Free"
EQ R5, R1
JZ R5, EXIT
MOV [R2], [1024]
MOV [1024], R2
POP BP
RET
