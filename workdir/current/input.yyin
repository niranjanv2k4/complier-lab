decl
    tuple student(int id, str name, int marks) s, *p1, *p2;
enddecl

int main() {
begin
    p1 = &s;
    p2 = &s;

    write("Read 'p1' : ");
    read((*p1).id);
    read((*p1).name);
    read((*p1).marks);

    write("Print 's' : ");
    write(s.id);
    write(s.name);
    write(s.marks);
    write("Print 'p1' : ");
    write((*p1).id);
    write((*p1).name);
    write((*p1).marks);
    write("Print 'p2' : ");
    write((*p2).id);
    write((*p2).name);
    write((*p2).marks);

    write("Read 'p2' : ");
    read((*p2).id);
    read((*p2).name);
    read((*p2).marks);

    write("Print 's' : ");
    write(s.id);
    write(s.name);
    write(s.marks);
    write("Print 'p1' : ");
    write((*p1).id);
    write((*p1).name);
    write((*p1).marks);
    write("Print 'p2' : ");
    write((*p2).id);
    write((*p2).name);
    write((*p2).marks);

    write("Read 's' : ");
    read(s.id);
    read(s.name);
    read(s.marks);
    write("Print 's' : ");
    write(s.id);
    write(s.name);
    write(s.marks);
    write("Print 'p1' : ");
    write((*p1).id);
    write((*p1).name);
    write((*p1).marks);
    write("Print 'p2' : ");
    write((*p2).id);
    write((*p2).name);
    write((*p2).marks);

    return 0;
end
}
