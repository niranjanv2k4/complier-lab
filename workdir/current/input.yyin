decl
  int sumAvg(int *a, int *b, int *avg), *o;
enddecl

int sumAvg(int *a, int *b, int *avg)
{
  decl
    int s;
  enddecl
begin
  s = *a + *b;
  *avg = s / 2;
  return s;
end
}

int main()
{
  decl
    int x, y, total, average, *p;
  enddecl
begin
o = &x;
  write("Enter two numbers: ");
  read(x);
  read(y);

  total = sumAvg(&x, &y, &average);

  write("Sum : ");
  write(total);
  write("Average : ");
  write(average);

  return 1+1;
end
}
