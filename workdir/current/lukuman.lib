EXIT:
MOV R0, SP
ADD R0, -4
MOV R1, [R0];
ADD R0, 1
MOV R2, [R0];
ADD R0, 1
MOV R3, [R0];
MOV R4, 10
PUSH R4
PUSH R1
PUSH R2
PUSH R3
PUSH R4
INT 10
