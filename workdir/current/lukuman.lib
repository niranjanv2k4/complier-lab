INIT:
MOV R1, 1024
LOOP:
MOV R0, R1 
LT R0, 2040
JZ R0, PARI
MOV R0, R1
ADD R0, 8
MOV [R1], R0
ADD R1, 8
JMP LOOP 
PARI:
MOV [2040], -1
JMP END
ALLOC:
MOV R1, [1024]
EQ R1, -1
MOV R0, -1
JNZ R1, SOME_WHERE
MOV R0, [1024]
MOV R2, [R0]
MOV R1, [1024]
MOV [1024], R2
SOME_WHERE:
MOV R19, R0
JMP END
FREE:
MOV R0, SP
ADD R0, -4
MOV R0, [R0]
MOV R1, [1024]
MOV [1024], R0
MOV [R0], R1
MOV R19, -1
JMP END
END:
POP R1
POP R2
POP R2
POP R2
POP R2 
MOV R2, SP
MOV R3, 1
SUB R2, R3
