BRKP
MOV R0, SP
MOV R1, 5
SUB R0, R1
MOV R0, [R0]
MOV R3 , "write"
EQ R3, R0
JNZ R3, WRITE
MOV R3 , "read"
EQ R3, R0
JNZ R3, READ
MOV R3 , "exit"
EQ R3, R0
JNZ R3, EXIT
MOV R3 , "init"
EQ R3, R0
JNZ R3, INIT
MOV R3 , "alloc"
EQ R3, R0
JNZ R3, ALLOC
MOV R3 , "free
EQ R3, R0
