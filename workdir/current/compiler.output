Grammar

    0 $accept: program $end

    1 program: TypeDefBlock ClassDefBlock GDeclBlock FDefBlock MainBlock
    2        | TypeDefBlock ClassDefBlock GDeclBlock MainBlock
    3        | TypeDefBlock ClassDefBlock MainBlock

    4 $@1: %empty

    5 $@2: %empty

    6 ClassDefBlock: CLASS $@1 ClassDefList $@2 ENDCLASS
    7              | %empty

    8 ClassDefList: ClassDefList ClassDef
    9             | ClassDef

   10 ClassDef: Cname '{' DECL Fieldlists MethodDecl ENDDECL MethodDefns '}'

   11 Cname: ID
   12      | ID EXTENDS ID

   13 Fieldlists: Fieldlists Fld
   14           | %empty

   15 Fld: Type ID EOL

   16 MethodDecl: MethodDecl MDecl
   17           | MDecl

   18 MDecl: Type ID '(' ParamList ')' EOL

   19 MethodDefns: MethodDefns Fdef
   20            | Fdef

   21 TypeDefBlock: TYPE TypeDefList ENDTYPE
   22             | %empty

   23 TypeDefList: TypeDefList TypeDef
   24            | TypeDef

   25 $@3: %empty

   26 TypeDef: ID $@3 '{' FieldDeclList '}'

   27 FieldDeclList: FieldDeclList FieldDecl
   28              | FieldDecl

   29 FieldDecl: Type ID EOL

   30 GDeclBlock: DECL GDeclList ENDDECL
   31           | DECL ENDDECL

   32 GDeclList: GDeclList GDecl
   33          | GDecl

   34 GDecl: Type GidList EOL

   35 Type: INT
   36     | STR
   37     | ID

   38 GidList: GidList ',' Gid
   39        | Gid

   40 Gid: ID
   41    | STAR ID
   42    | ID '[' NUM ']'
   43    | ID '(' ParamList ')'

   44 FDefBlock: FDefBlock Fdef
   45          | Fdef

   46 Fdef: INT ID '(' ParamList ')' '{' LDeclBlock Coderegion '}'
   47     | STR ID '(' ParamList ')' '{' LDeclBlock Coderegion '}'
   48     | ID ID '(' ParamList ')' '{' LDeclBlock Coderegion '}'

   49 MainBlock: INT MAIN '(' ')' '{' LDeclBlock Coderegion '}'

   50 ParamList: ParamList ',' Param
   51          | Param
   52          | %empty

   53 Param: INT ID
   54      | STR ID
   55      | INT STAR ID
   56      | STR STAR ID
   57      | ID STAR ID
   58      | ID ID

   59 LDeclBlock: DECL LDeclList ENDDECL
   60           | DECL ENDDECL
   61           | %empty

   62 LDeclList: LDeclList LDecl
   63          | LDecl

   64 LDecl: Type IdList EOL

   65 IdList: IdList ',' ID
   66       | ID
   67       | IdList ',' STAR ID
   68       | STAR ID

   69 Coderegion: T_BEGIN Slist RtnStmt T_END

   70 RtnStmt: RETURN expr EOL

   71 Slist: Slist Stmt
   72      | Stmt

   73 Stmt: InputStmt
   74     | OutputStmt
   75     | AsgnStmt
   76     | IfStmt
   77     | WhileStmt
   78     | BREAK EOL
   79     | CONTINUE EOL
   80     | RptUntlStmt
   81     | DoWhileStmt
   82     | FREE '(' IDENTIFIERS ')' EOL
   83     | DELETE '(' ID ')'

   84 InputStmt: READ '(' IDENTIFIERS ')' EOL

   85 OutputStmt: WRITE '(' expr ')' EOL

   86 AsgnStmt: IDENTIFIERS ASSGN expr EOL
   87         | IDENTIFIERS ASSGN ALLOC '(' ')' EOL
   88         | IDENTIFIERS ASSGN INITIALIZE '(' ')' EOL
   89         | ID ASSGN NEW '(' ID ')' EOL
   90         | IDENTIFIERS ASSGN NEW '(' ID ')' EOL

   91 IfStmt: IF '(' expr ')' THEN Slist ELSE Slist ENDIF EOL
   92       | IF '(' expr ')' THEN Slist ENDIF EOL

   93 WhileStmt: WHILE '(' expr ')' DO Slist END_WHILE EOL

   94 RptUntlStmt: REPEAT '{' Slist '}' UNTILL '(' expr ')' EOL

   95 DoWhileStmt: DO '{' Slist '}' WHILE '(' expr ')' EOL

   96 expr: expr ADD expr
   97     | expr SUB expr
   98     | expr STAR expr
   99     | expr DIV expr
  100     | expr MOD expr
  101     | expr EQ expr
  102     | expr NE expr
  103     | expr GT expr
  104     | expr GE expr
  105     | expr LT expr
  106     | expr LE expr
  107     | expr OR expr
  108     | expr AND expr
  109     | '(' expr ')'
  110     | NUM
  111     | STR_LITERAL
  112     | IDENTIFIERS
  113     | IDENTIFIERS '(' ArgList ')'
  114     | NULL_VAL

  115 IDENTIFIERS: ID
  116            | SELF
  117            | ID '[' expr ']'

  118 ArgList: ArgList ',' expr
  119        | expr
  120        | %empty


