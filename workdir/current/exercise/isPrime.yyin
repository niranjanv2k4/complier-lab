decl
    int n, i, isPrime;
enddecl

begin
    write("Enter number: ");
    read(n);

    if (n <= 1) then
        isPrime = 0;
    else
        isPrime = 1;
        i = 2;
        while (i <= (n / 2)) do
            if ((n % i) == 0) then
                isPrime = 0;
            endif;
            i = i + 1;
        endwhile;
    endif;

    if (isPrime == 1) then
        write("Prime");
    else
        write("Not Prime");
    endif;
end;
