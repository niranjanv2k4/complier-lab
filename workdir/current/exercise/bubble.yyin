decl
    int a[10];
    int n;
    int globalSum;
int bubbleSort(int size);
    int sumArray(int size);
enddecl

int sumArray(int size){
    decl
        int i, sum;
    enddecl
begin
    sum = 0;
    i = 0;
    while (i < size) do
        sum = sum + a[i];
        i = i + 1;
    endwhile;
    return sum;
end
}

int bubbleSort(int size){
    decl
        int i, j, temp;
    enddecl
begin
    i = 0;
    while (i < size) do
        j = 0;
        while (j < (size - i - 1)) do
            if (a[j] > a[j+1]) then
                temp = a[j];
                a[j] = a[j+1];
                a[j+1] = temp;
            endif;
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;
    return temp;
end
}

int main(){
    decl
        int i;
    enddecl
begin
    write("Enter number of elements : ");
    read(n);

    write("Enter array elements : ");
    i = 0;
    while (i < n) do
        read(a[i]);
        i = i + 1;
    endwhile;


    write("Sorted array : ");
    i = 0;
    while (i < n) do
        write(a[i]);
        i = i + 1;
    endwhile;

    globalSum = sumArray(n);
    write("Sum of array : ");
    write(globalSum);

    return 0;
end
}
