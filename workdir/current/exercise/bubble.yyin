decl
    int arr[10];
    int i, j, temp;
enddecl

begin
    i = 0;
    write("Enter array : ");
    while (i < 10) do
        read(arr[i]);
        i = i + 1;
    endwhile;

    i = 0;
    while (i < 10) do
        j = 0;
        while (j < (10 - i - 1)) do
            if (arr[j] > arr[j+1]) then
                temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            endif;
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;
    write("Sorted :");
    i = 0;
    while (i < 10) do
        write(arr[i]);
        i = i + 1;
    endwhile;
end;
